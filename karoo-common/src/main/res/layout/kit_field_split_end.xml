<?xml version="1.0" encoding="utf-8"?>
<!-- karoo-common: a field shown as its header band at true size over a body that fills the rest
     (KarooField.views). The Karoo can shorten a row (a map page with a route) without telling the
     app; one fitXY picture would then squash the header too. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/kit_field_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/kit_field_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitEnd" />

    <ImageView
        android:id="@+id/kit_field_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />
</LinearLayout>
